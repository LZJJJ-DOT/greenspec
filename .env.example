# GreenSpec environment template
# Copy this file to .env and fill in your own API keys.

# DeepSeek chat LLM
DEEPSEEK_API_KEY=

# Web search
TAVILY_API_KEY=

# OpenAI embedding
# Required while EMBEDDING uses openai:text-embedding-3-small.
OPENAI_API_KEY=

# Format: <provider>:<model>
FAST_LLM=deepseek:deepseek-v4-flash
SMART_LLM=deepseek:deepseek-v4-pro
STRATEGIC_LLM=deepseek:deepseek-v4-pro

# DeepSeek currently provides the chat models above.
# GreenSpec continues to use OpenAI for embeddings.
EMBEDDING=openai:text-embedding-3-small

# Search and local documents
RETRIEVER=tavily
DOC_PATH=./my-docs

# Optional scraper tuning
# MAX_SCRAPER_WORKERS=15
# SCRAPER_RATE_LIMIT_DELAY=0.0
# COMPRESSION_THRESHOLD=8000

# Optional LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=greenspec